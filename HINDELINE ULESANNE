CREATE PROCEDURE muudatus
    @Nimi varchar(10),
    @Linn varchar(25),
    @Vanus int, 
    @Saldo money
AS
BEGIN
    DECLARE @sqltegevus varchar(max);

    SET @sqltegevus = CASE 
        WHEN @Nimi = 'add' THEN 
            CONCAT('ALTER TABLE ', @Linn, ' ADD ', @Vanus, ' ', @Saldo)

        WHEN @nimi = 'drop' THEN 
            CONCAT('ALTER TABLE ', @Linn, ' DROP COLUMN ', @Vanus)
    END;

    PRINT @sqltegevus;
    EXEC (@sqltegevus);
END;


-- veeru lisamine
