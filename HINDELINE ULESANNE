-- output

CREATE PROCEDURE minmaxHind3
    @minHind MONEY OUTPUT,
    @maxHind MONEY OUTPUT
AS
BEGIN
    SELECT
        @minHind = MIN(Saldo),
        @maxHind = MAX(Saldo)
    FROM kliendid3;
END;
GO

-- kasutamine

DECLARE @minHind MONEY, @maxHind MONEY;

EXEC minmaxHind3 @minHind OUTPUT, @maxHind OUTPUT;

PRINT 'Min hind = ' + CONVERT(varchar, @minHind);
PRINT 'Max hind = ' + CONVERT(varchar, @maxHind);
