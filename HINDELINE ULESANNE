--Otsi klienti prots.

CREATE PROCEDURE otsingidtaht
@taht char(1)
AS
BEGIN
    SELECT First_name FROM kliendid3 
	WHERE First_name LIKE @taht + '%'
END

--kutse
EXEC otsingidtaht 'r'


--Muuda kliendi andmeid prots.

CREATE PROCEDURE uuendaKliendi2
@id int,
@uuendatudNimi varchar(20)
AS 
BEGIN
    SELECT * FROM kliendid3;
    UPDATE kliendid3 SET City=@uuendatudNimi 
	WHERE klient_id=@id;
	SELECT * FROM kliendid3;
END

