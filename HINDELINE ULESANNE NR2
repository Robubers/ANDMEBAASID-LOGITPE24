create database MovieBase
use MovieBase

CREATE TABLE Movies (
MovieID INT PRIMARY KEY IDENTITY(1,1),
MovieName VARCHAR(100) NOT NULL,
MovieYear INT NOT NULL,
MovieDirector VARCHAR(50),
MovieCost MONEY
);

